<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <package android:name="com.Huffer342.shiyin" />
    </queries>
    <application android:allowBackup="false" android:label="闹钟实验" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver android:name=".BootProbeReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="com.Huffer342.shiyin.alarmprobe.SYNC_ALARM" />
                <action android:name="com.Huffer342.shiyin.alarmprobe.FIRE_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>
        <provider
            android:name=".CompanionSyncProvider"
            android:authorities="com.Huffer342.shiyin.alarmprobe.sync"
            android:exported="true" />
        <service android:name=".WaitingService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="systemExempted" />
        <service android:name=".ProbeService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
